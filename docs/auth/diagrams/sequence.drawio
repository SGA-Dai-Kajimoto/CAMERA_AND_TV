        <mxCell id="title" value="Camera TV 認証シーケンス（PKCE 擬似デバイスフロー）" style="text;html=1;strokeColor=none;fillColor=none;fontSize=28;fontStyle=1;fontFamily=Yu Gothic;align=left;verticalAlign=middle;" vertex="1" parent="1">
