        <mxCell id="m7" value="/device/code → auth_code" style="endArrow=block;html=1;rounded=0;strokeWidth=2;strokeColor=#e67e22;fontSize=13;fontFamily=Yu Gothic;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="545" y="840" as="sourcePoint" /><mxPoint x="185" y="840" as="targetPoint" /></mxGeometry>
