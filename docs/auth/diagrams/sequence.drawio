        <mxCell id="phase1" value="1. TVが開始" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef4ff;strokeColor=#4084ff;fontSize=16;fontStyle=1;fontFamily=Yu Gothic;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="235" width="1360" height="36" as="geometry" />
        </mxCell>
        <mxCell id="self1" value="code_verifier生成&lt;br&gt;code_challenge算出" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#4084ff;fontSize=13;fontFamily=Yu Gothic;" vertex="1" parent="1">
          <mxGeometry x="68" y="294" width="235" height="58" as="geometry" />
        </mxCell>
        <mxCell id="m1" value="POST /device/authorize&lt;br&gt;code_challenge" style="endArrow=block;html=1;rounded=0;strokeWidth=2;strokeColor=#4084ff;fontSize=13;fontFamily=Yu Gothic;" edge="1" parent="1" source="self1" target="sv">
          <mxGeometry relative="1" as="geometry"><mxPoint x="300" y="330" as="sourcePoint" /><mxPoint x="430" y="330" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="self2" value="device_code / user_code / state を生成&lt;br&gt;セッション保存" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#e67e22;fontSize=13;fontFamily=Yu Gothic;" vertex="1" parent="1">
          <mxGeometry x="410" y="374" width="270" height="58" as="geometry" />
        </mxCell>
        <mxCell id="m2" value="device_code / user_code / QR URL" style="endArrow=block;html=1;rounded=0;strokeWidth=2;strokeColor=#e67e22;fontSize=13;fontFamily=Yu Gothic;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="430" y="462" as="sourcePoint" /><mxPoint x="290" y="462" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="self3" value="QR と確認コードを表示&lt;br&gt;/device/code をポーリング" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#4084ff;fontSize=13;fontFamily=Yu Gothic;" vertex="1" parent="1">
          <mxGeometry x="68" y="492" width="235" height="58" as="geometry" />
        </mxCell>
        <mxCell id="phase2" value="2. PCブラウザでログイン" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf7ed;strokeColor=#1c9c61;fontSize=16;fontStyle=1;fontFamily=Yu Gothic;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="585" width="1360" height="36" as="geometry" />
        </mxCell>
        <mxCell id="m3" value="GET /device?user_code=..." style="endArrow=block;html=1;rounded=0;strokeWidth=2;strokeColor=#1c9c61;fontSize=13;fontFamily=Yu Gothic;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="800" y="655" as="sourcePoint" /><mxPoint x="660" y="655" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="m4" value="302 AccountPF認可URL&lt;br&gt;code_challenge + redirect_url" style="endArrow=block;html=1;rounded=0;strokeWidth=2;strokeColor=#e67e22;fontSize=13;fontFamily=Yu Gothic;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="660" y="705" as="sourcePoint" /><mxPoint x="1150" y="705" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="m5" value="/callback/{state}?auth_code=..." style="endArrow=block;html=1;rounded=0;strokeWidth=2;strokeColor=#d04;fontSize=13;fontFamily=Yu Gothic;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="1150" y="755" as="sourcePoint" /><mxPoint x="660" y="755" as="targetPoint" /></mxGeometry>
