        </mxCell>
        <mxCell id="note" value="赤い矢印は秘密値。code_verifier と token は中継サーバーを通らず、TV と AccountPF の HTTPS 通信だけで扱う。" style="text;html=1;strokeColor=none;fillColor=none;fontSize=16;fontFamily=Yu Gothic;align=left;verticalAlign=middle;fontColor=#555555;" vertex="1" parent="1">
