        <mxCell id="phase3" value="3. TVが直接トークン交換" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffecec;strokeColor=#d04;fontSize=16;fontStyle=1;fontFamily=Yu Gothic;align=left;spacingLeft=12;" vertex="1" parent="1">
